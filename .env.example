# Copy to .env and fill with your Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Must be a WhatsApp-enabled Twilio number, prefixed with whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+17343367101

# --- Per-channel Docker deployment (infrastructure/) ---
# This .env is the SINGLE durable source for the deploy host: setup.sh installs
# it to ~/.env, boot.sh loads it, and the compose files substitute ${VAR}.
# Keep secrets here, not duplicated into each instance's openclaw.json.

# Discord bot token the router uses to receive/send messages. Raw token only
# (no "DISCORD_BOT_TOKEN=" prefix inside the value).
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Whitelist for /channel register|unregister: the auth guild and the role
# within it that grants access. Unset => /channel management fails closed.
OPENCLAW_AUTH_GUILD_ID=000000000000000000
OPENCLAW_WHITELIST_ROLE_ID=000000000000000000

# Host provisioning daemon the router calls over loopback for /channel
# register|unregister. Unset => those commands are disabled.
OPENCLAW_PROVISIONER_PORT=18790
OPENCLAW_PROVISIONER_TOKEN=generate_a_random_secret_here
