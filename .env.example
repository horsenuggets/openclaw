# Copy to .env and fill with real values. All IDs, tokens, and numbers below are
# placeholders.
#
# Two kinds of variables live here:
#   * Deployed vars are installed on the prod host as ~/.env by
#     infrastructure/deploy/setup.sh; boot.sh loads them and the compose files
#     substitute ${VAR}. deploy.sh currently copies the whole .env, so keep
#     local/lab-only values out of a prod-bound .env (a prod-key allowlist in
#     deploy.sh is a planned follow-up).
#   * Local/lab vars are not needed on prod; leave them unset in a prod-bound
#     .env. Most are read only by operator tooling (deploy scripts, the
#     prod-mirror rig, e2e tests) from that tool's shell environment, so putting
#     them in .env only helps if you EXPORT them first, e.g. `set -a; source
#     .env; set +a` (plain `source .env` does not pass values to child
#     processes). The one exception is OPENCLAW_ADMIN_OVERRIDE_IDS, which the
#     router reads in any environment (see its note below) — so leaving it unset
#     on prod is what keeps it lab-only.

# --- Twilio (WhatsApp), optional ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Must be a WhatsApp-enabled Twilio number, prefixed with whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000

# --- Deployed: per-channel Docker deployment (installed as ~/.env on prod) ---

# Discord bot token the router uses to receive/send messages (the production
# router bot). Raw token only (no "DISCORD_BOT_TOKEN=" prefix inside the value).
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Whitelist for /channel register|unregister: the auth guild and the role
# within it that grants access. Unset => /channel management fails closed.
OPENCLAW_AUTH_GUILD_ID=000000000000000000
OPENCLAW_WHITELIST_ROLE_ID=000000000000000000

# Optional higher-privilege admin role within the same auth guild: may register
# any channel (incl. on another user's behalf) and unregister any channel. Unset
# => nobody is admin (only owner/whitelisted-DM rules apply). Fails closed.
OPENCLAW_ADMIN_ROLE_ID=000000000000000000

# Host provisioning daemon the router calls over loopback for /channel
# register|unregister. Unset => those commands are disabled.
OPENCLAW_PROVISIONER_PORT=18810
OPENCLAW_PROVISIONER_TOKEN=generate_a_random_secret_here

# Comma-separated bot user IDs allowed to hold normal conversations with the
# agent (not just run /channel commands). Intended for an automated tester bot
# driving end-to-end tests; every other bot stays filtered to avoid reply loops.
OPENCLAW_ROUTER_ALLOW_BOT_IDS=000000000000000000

# When a non-owner messages a registered channel, reply with an auto-deleting
# Log embed explaining the channel belongs to someone else (default: enabled).
# Set to a falsy value (0/false/no/off) to deny silently with no reply.
OPENCLAW_ROUTER_UNAUTHORIZED_NOTICE=true

# Loopback port for the local whisper speech-to-text server used to transcribe
# voice messages. One value drives both the server bind and the router client
# (boot.sh passes it through), so they never drift. Unset => boot.sh defaults to
# 18700 (matching DEFAULT_WHISPER_PORT in src/config/port-defaults.ts). Override
# only if 18700 collides on the host, e.g. WSL mirrored networking sharing the
# port with another distro.
# WHISPER_PORT=18700

# Agent bridge the per-channel boxes run on. boot.sh REQUIRES all three (no
# defaults): a missing value aborts the deploy rather than guessing a subnet that
# might collide on the host. The router binds its model/container proxies to the
# gateway IP (exported as OPENCLAW_PROXY_BIND) so boxes reach them over the bridge
# while the proxies stay off the public NIC. Pick a subnet that is free on the host.
OPENCLAW_AGENT_NETWORK=oc-agents
OPENCLAW_AGENT_SUBNET=172.30.0.0/24
OPENCLAW_AGENT_GATEWAY=172.30.0.1

# --- Local/lab only: not needed on prod (leave unset in a prod-bound .env) ---

# SSH host or alias the deploy/status scripts connect to. Read from the process
# environment, so export it (e.g. `set -a; source .env; set +a`, or
# `export OPENCLAW_DEPLOY_HOST=...`) before running infrastructure/deploy/deploy.sh
# or status.sh; filling it in .env alone does not configure them.
# (mint-anthropic-reauth.sh does read it from .env.)
# OPENCLAW_DEPLOY_HOST=user@gateway-host

# Token for the driver bot that posts /channel register and chats in the Discord
# e2e tests (src/discord/e2e). The helper reads it from the process environment
# (DISCORD_E2E_BOT_TOKEN), not from a deployed .env. Export it from a local-only
# secret source; do not put it in a prod-bound .env.
# DISCORD_E2E_BOT_TOKEN=your_e2e_driver_bot_token_here

# Discord user id of the human who sends the voice message in the manual voice
# transcription e2e test (voice-transcription.e2e.test.ts). The router routes a
# guild message only for the channel's recorded owner, so that test registers
# the channel on this human's behalf. Unset => the human's voice is not routed
# and the test cannot pass. Local/lab only.
# DISCORD_E2E_VOICE_OWNER_ID=000000000000000000

# Dedicated bot token (NOT the prod one) for the local prod-mirror DinD rig:
# scripts/prod-mirror.sh up --live reads it from the process environment. Reusing
# the prod bot would open a second gateway session and fight prod. Export it
# locally; do not put it in a prod-bound .env.
# OPENCLAW_MIRROR_DISCORD_TOKEN=your_test_bot_token_here

# Comma-separated user/bot IDs the router treats as admin + whitelist WITHOUT the
# auth-guild role lookup, for lab rigs whose router bot is not in the auth server.
# The router reads it in any environment, so leave it UNSET on prod (a bypass of
# the auth server); it is intended only for local/lab .env. Unset => no override.
# OPENCLAW_ADMIN_OVERRIDE_IDS=000000000000000000,000000000000000000
