#!/usr/bin/env bash
# openclawctl — Management script for OpenClaw channel-based agent containers.
# Runs on the WSL host. Manages the port registry, instance directories,
# and Docker containers for per-channel agents.
set -euo pipefail

INSTANCES_DIR="$HOME/.openclaw-instances"
PORTS_FILE="$INSTANCES_DIR/ports.json"
AGENT_YML="$HOME/deploy/docker/agent.yml"

# Ensure instances directory exists
mkdir -p "$INSTANCES_DIR"

# --- Port registry helpers ---

ensure_ports_file() {
  if [ ! -f "$PORTS_FILE" ]; then
    echo '{"basePort": 18789, "assignments": {}}' > "$PORTS_FILE"
  fi
}

# Atomic write: write to temp file, then rename (prevents corruption)
write_ports_file() {
  local content="$1"
  local tmp="${PORTS_FILE}.tmp.$$"
  echo "$content" > "$tmp"
  mv "$tmp" "$PORTS_FILE"
}

get_port() {
  local channelId="$1"
  python3 -c "
import json
ports = json.load(open('$PORTS_FILE'))
print(ports.get('assignments', {}).get('$channelId', ''))
"
}

allocate_port() {
  python3 -c "
import json
ports = json.load(open('$PORTS_FILE'))
used = set(ports.get('assignments', {}).values())
port = ports.get('basePort', 18789)
while port in used:
    port += 1
print(port)
"
}

assign_port() {
  local channelId="$1"
  local port="$2"
  python3 -c "
import json, os
ports = json.load(open('$PORTS_FILE'))
# Check for port conflict
used = ports.get('assignments', {})
for cid, p in used.items():
    if p == $port and cid != '$channelId':
        print(f'ERROR: port $port already assigned to {cid}', flush=True)
        exit(1)
ports.setdefault('assignments', {})['$channelId'] = $port
tmp = '$PORTS_FILE.tmp.' + str(os.getpid())
with open(tmp, 'w') as f:
    json.dump(ports, f, indent=2)
    f.write('\n')
os.rename(tmp, '$PORTS_FILE')
"
}

free_port() {
  local channelId="$1"
  python3 -c "
import json, os
ports = json.load(open('$PORTS_FILE'))
ports.get('assignments', {}).pop('$channelId', None)
tmp = '$PORTS_FILE.tmp.' + str(os.getpid())
with open(tmp, 'w') as f:
    json.dump(ports, f, indent=2)
    f.write('\n')
os.rename(tmp, '$PORTS_FILE')
"
}

# Reconcile ports.json with actual instance directories.
# Removes stale entries (dirs that don't exist), warns about dirs without ports.
reconcile_ports() {
  python3 -c "
import json, os
ports = json.load(open('$PORTS_FILE'))
assignments = ports.get('assignments', {})
instances_dir = '$INSTANCES_DIR'
changed = False

# Remove entries whose instance directories no longer exist
stale = [cid for cid in assignments if not os.path.isdir(os.path.join(instances_dir, cid))]
for cid in stale:
    print(f'  Removing stale entry: {cid} (port {assignments[cid]})')
    del assignments[cid]
    changed = True

# Warn about dirs without port assignments
import re
for entry in sorted(os.listdir(instances_dir)):
    if re.match(r'^\d{17,20}$', entry) and entry not in assignments:
        print(f'  Warning: {entry} has no port assignment')

if changed:
    tmp = '$PORTS_FILE.tmp.' + str(os.getpid())
    with open(tmp, 'w') as f:
        json.dump(ports, f, indent=2)
        f.write('\n')
    os.rename(tmp, '$PORTS_FILE')
    print('  Ports file updated.')
else:
    print('  No changes needed.')
"
}

# --- Config provisioning ---

# Copy an existing instance's openclaw.json into a new channel dir and sanitize
# it so inherited configs pick up required fixes. Historically instances were
# provisioned with in-container paths under /home/node (a leftover from an older
# container that ran as the `node` user); the container now mounts to
# /root/.openclaw, so a stale /home/node path silently breaks workspace/memory
# loading. We also force skipBootstrapFile so router-managed instances (which own
# onboarding) never inherit or keep a stale BOOTSTRAP.md. Keep these paths in sync
# with the mount target in agent.yml.
provision_config() {
  local channelId="$1"
  local dest="$INSTANCES_DIR/$channelId/openclaw.json"

  for dir in "$INSTANCES_DIR"/*/; do
    [ -d "$dir" ] || continue
    if [ -f "${dir}openclaw.json" ]; then
      cp "${dir}openclaw.json" "$dest"
      echo "Copied config from $(basename "$dir")"
      break
    fi
  done

  if [ ! -f "$dest" ]; then
    # No template to copy: the new channel cannot start without a config. Signal
    # failure so the caller can roll back the port assignment / instance dir it
    # created, rather than leaving an orphaned port that makes retries no-op.
    echo "Error: no existing instance config to copy; cannot provision $channelId." >&2
    return 1
  fi

  # Sanitize best-effort. A parse "error" must not abort provisioning (that would
  # leave an orphaned port assignment); the copied config is still a valid app
  # config, so we keep it and warn.
  local outcome
  outcome=$(sanitize_config_file "$dest")
  if [ "$outcome" = "error" ]; then
    echo "Warning: could not sanitize $dest; using copied config as-is." >&2
  else
    echo "Sanitized config for $channelId ($outcome)"
  fi
}

# Repair a config file in place. Prints one of: changed | unchanged | error.
# OpenClaw parses config as JSON5 (comments, trailing commas allowed), so a strict
# json.loads would reject valid configs. We try strict JSON first (clean rewrite),
# and fall back to targeted textual edits that preserve JSON5 syntax. On any
# unexpected failure we print "error" and leave the file untouched so callers can
# decide how to proceed instead of aborting mid-provision.
sanitize_config_file() {
  local configPath="$1"
  python3 - "$configPath" <<'PY'
import json, re, sys

path = sys.argv[1]
try:
    with open(path) as f:
        raw = f.read()
except OSError:
    print("error")
    sys.exit(0)

# Fast path: strict JSON parses cleanly, so rewrite it normalized.
try:
    cfg = json.loads(raw)
except ValueError:
    cfg = None

if cfg is not None:
    defaults = cfg.setdefault("agents", {}).setdefault("defaults", {})

    ws = defaults.get("workspace")
    if isinstance(ws, str) and ws.startswith("/home/node/"):
        defaults["workspace"] = ws.replace("/home/node/", "/root/", 1)

    cache = defaults.get("memorySearch", {}).get("local", {}).get("modelCacheDir")
    if isinstance(cache, str) and cache.startswith("/home/node/"):
        defaults["memorySearch"]["local"]["modelCacheDir"] = cache.replace(
            "/home/node/", "/root/", 1
        )

    # Router owns onboarding; never inherit/keep a stale BOOTSTRAP.md.
    defaults["skipBootstrapFile"] = True

    normalized = json.dumps(cfg, indent=2) + "\n"
    if normalized != raw:
        try:
            with open(path, "w") as f:
                f.write(normalized)
        except OSError:
            print("error")
            sys.exit(0)
        print("changed")
    else:
        print("unchanged")
    sys.exit(0)

# JSON5 fallback: preserve the original (comments/commas) and only patch the
# specific agents.defaults fields we care about, via string edits.
def patch_agents_defaults_json5(raw_text: str) -> str:
    def skip_ws_comments(text: str, index: int, limit: int) -> int:
        while index < limit:
            if text[index].isspace():
                index += 1
                continue
            if text.startswith("//", index):
                newline = text.find("\n", index, limit)
                if newline == -1:
                    return limit
                index = newline + 1
                continue
            if text.startswith("/*", index):
                comment_end = text.find("*/", index + 2, limit)
                if comment_end == -1:
                    return limit
                index = comment_end + 2
                continue
            break
        return index

    def skip_string(text: str, index: int, limit: int) -> int:
        quote = text[index]
        index += 1
        while index < limit:
            ch = text[index]
            if ch == "\\":
                index += 2
                continue
            if ch == quote:
                return index + 1
            index += 1
        return limit

    def parse_property_name(text: str, index: int, limit: int):
        if index >= limit:
            return None, index
        ch = text[index]
        if ch in ("'", '"'):
            end = skip_string(text, index, limit)
            return text[index + 1 : end - 1], end
        if ch.isalpha() or ch in "_$":
            end = index + 1
            while end < limit and (text[end].isalnum() or text[end] in "_$"):
                end += 1
            return text[index:end], end
        return None, index

    def skip_value(text: str, index: int, limit: int) -> int:
        # Advance past a JSON5 value (string, object, array, or primitive) so the
        # property scan never descends into a value's contents (e.g. a string
        # literal that itself contains "agents: {").
        if index >= limit:
            return limit
        ch = text[index]
        if ch in ("'", '"'):
            return skip_string(text, index, limit)
        if ch in "{[":
            close = "}" if ch == "{" else "]"
            depth = 0
            while index < limit:
                c = text[index]
                if text.startswith("//", index) or text.startswith("/*", index):
                    index = skip_ws_comments(text, index, limit)
                    continue
                if c in ("'", '"'):
                    index = skip_string(text, index, limit)
                    continue
                if c == ch:
                    depth += 1
                elif c == close:
                    depth -= 1
                    if depth == 0:
                        return index + 1
                index += 1
            return limit
        # Primitive: run to the next comma or closing brace/bracket at this level.
        while index < limit and text[index] not in ",}]":
            index += 1
        return index

    def find_object_property_start(text: str, property_name: str, start: int, limit: int):
        # Depth-0, string/comment-aware scan for a top-level object property whose
        # value is an object. Skips over each value so text inside strings/arrays
        # cannot be mistaken for a property name.
        index = start
        # Enter the enclosing object body if we start on its opening brace.
        while index < limit and text[index] != "{":
            index = skip_ws_comments(text, index, limit)
            if index < limit and text[index] != "{":
                index += 1
        if index < limit and text[index] == "{":
            index += 1
        while index < limit:
            index = skip_ws_comments(text, index, limit)
            if index >= limit or text[index] == "}":
                return None
            name, next_index = parse_property_name(text, index, limit)
            if name is None:
                index += 1
                continue
            colon = skip_ws_comments(text, next_index, limit)
            if colon >= limit or text[colon] != ":":
                index = next_index
                continue
            value_start = skip_ws_comments(text, colon + 1, limit)
            if name == property_name and value_start < limit and text[value_start] == "{":
                return value_start
            # Skip the whole value, then any trailing comma, before continuing.
            index = skip_value(text, value_start, limit)
            index = skip_ws_comments(text, index, limit)
            if index < limit and text[index] == ",":
                index += 1
        return None

    def find_matching_brace(text: str, start: int, limit: int):
        depth = 0
        index = start
        while index < limit:
            if text.startswith("//", index):
                newline = text.find("\n", index, limit)
                if newline == -1:
                    return None
                index = newline + 1
                continue
            if text.startswith("/*", index):
                comment_end = text.find("*/", index + 2, limit)
                if comment_end == -1:
                    return None
                index = comment_end + 2
                continue
            if text[index] in ("'", '"'):
                index = skip_string(text, index, limit)
                continue
            if text[index] == "{":
                depth += 1
            elif text[index] == "}":
                depth -= 1
                if depth == 0:
                    return index
            index += 1
        return None

    def find_root_object_bounds(text: str):
        limit = len(text)
        start = skip_ws_comments(text, 0, limit)
        while start < limit and text[start] != "{":
            start += 1
            start = skip_ws_comments(text, start, limit)
        if start >= limit or text[start] != "{":
            return None
        end = find_matching_brace(text, start, limit)
        if end is None:
            return None
        return start, end

    def insert_object_property(text: str, object_start: int, object_end: int, snippet: str) -> str:
        content_start = skip_ws_comments(text, object_start + 1, object_end)
        first_line_end = text.find("\n", content_start, object_end)
        if first_line_end == -1:
            first_line_end = object_end

        if content_start < object_end and text[content_start:first_line_end].strip():
            insert = f"{snippet} "
            insert_at = content_start
        else:
            line_start = text.rfind(
                "\n", 0, content_start if content_start < object_end else object_start
            ) + 1
            indent_match = re.match(
                r"[ \t]*",
                text[line_start : content_start if content_start < object_end else object_start],
            )
            indent = indent_match.group(0) if indent_match else ""
            insert = f"\n{indent}  {snippet}"
            insert_at = content_start
        return text[:insert_at] + insert + text[insert_at:]

    def object_has_property(text: str, object_start: int, object_end: int, property_name: str) -> bool:
        index = object_start + 1
        depth = 0
        while index < object_end:
            index = skip_ws_comments(text, index, object_end)
            if index >= object_end:
                return False
            if text[index] in ("'", '"'):
                name, next_index = parse_property_name(text, index, object_end)
                colon = skip_ws_comments(text, next_index, object_end)
                if depth == 0 and name == property_name and colon < object_end and text[colon] == ":":
                    return True
                index = next_index
                continue
            if text[index].isalpha() or text[index] in "_$":
                name, next_index = parse_property_name(text, index, object_end)
                colon = skip_ws_comments(text, next_index, object_end)
                if depth == 0 and name == property_name and colon < object_end and text[colon] == ":":
                    return True
                index = next_index
                continue
            if text[index] in "{[":
                depth += 1
            elif text[index] in "}]":
                depth = max(0, depth - 1)
            index += 1
        return False

    def find_direct_object_property_start(text: str, object_start: int, object_end: int, property_name: str):
        index = object_start + 1
        depth = 0
        while index < object_end:
            index = skip_ws_comments(text, index, object_end)
            if index >= object_end:
                return None
            if text[index] in ("'", '"'):
                name, next_index = parse_property_name(text, index, object_end)
                colon = skip_ws_comments(text, next_index, object_end)
                if colon < object_end and text[colon] == ":":
                    value_start = skip_ws_comments(text, colon + 1, object_end)
                    if depth == 0 and name == property_name and value_start < object_end:
                        return value_start
                    index = value_start
                    continue
                index = next_index
                continue
            if text[index].isalpha() or text[index] in "_$":
                name, next_index = parse_property_name(text, index, object_end)
                colon = skip_ws_comments(text, next_index, object_end)
                if colon < object_end and text[colon] == ":":
                    value_start = skip_ws_comments(text, colon + 1, object_end)
                    if depth == 0 and name == property_name and value_start < object_end:
                        return value_start
                    index = value_start
                    continue
                index = next_index
                continue
            if text[index] in "{[":
                depth += 1
            elif text[index] in "}]":
                depth = max(0, depth - 1)
            index += 1
        return None

    def find_agents_defaults_bounds(text: str):
        limit = len(text)
        agents_start = find_object_property_start(text, "agents", 0, limit)
        if agents_start is None:
            return None
        agents_end = find_matching_brace(text, agents_start, limit)
        if agents_end is None:
            return None
        defaults_start = find_direct_object_property_start(text, agents_start, agents_end, "defaults")
        if defaults_start is None or text[defaults_start] != "{":
            return None
        defaults_end = find_matching_brace(text, defaults_start, agents_end + 1)
        if defaults_end is None:
            return None
        return defaults_start, defaults_end

    def ensure_agents_defaults_object(text: str) -> str:
        if find_agents_defaults_bounds(text) is not None:
            return text

        root_bounds = find_root_object_bounds(text)
        if root_bounds is None:
            return text
        root_start, root_end = root_bounds

        agents_start = find_object_property_start(text, "agents", root_start, root_end + 1)
        if agents_start is None:
            return insert_object_property(
                text, root_start, root_end, '"agents": { "defaults": { "skipBootstrapFile": true } },'
            )

        agents_end = find_matching_brace(text, agents_start, root_end + 1)
        if agents_end is None:
            return text

        defaults_start = find_direct_object_property_start(text, agents_start, agents_end, "defaults")
        if defaults_start is None:
            return insert_object_property(
                text, agents_start, agents_end, '"defaults": { "skipBootstrapFile": true },'
            )
        return text

    def replace_prefixed_string_property(
        text: str, object_start: int, object_end: int, property_name: str
    ) -> str:
        value_start = find_direct_object_property_start(text, object_start, object_end, property_name)
        if value_start is None or value_start >= object_end or text[value_start] not in ("'", '"'):
            return text
        value_end = skip_string(text, value_start, object_end)
        if value_end <= value_start + 1:
            return text
        value = text[value_start + 1 : value_end - 1]
        if not value.startswith("/home/node/"):
            return text
        replacement = "/root/" + value[len("/home/node/") :]
        return text[: value_start + 1] + replacement + text[value_end - 1 :]

    def force_skip_bootstrap_file_flag(text: str) -> str:
        bounds = find_agents_defaults_bounds(text)
        if bounds is None:
            return text
        defaults_start, defaults_end = bounds

        skip_value_start = find_direct_object_property_start(
            text, defaults_start, defaults_end, "skipBootstrapFile"
        )
        if skip_value_start is not None:
            value_start = skip_ws_comments(text, skip_value_start, defaults_end)
            if text.startswith("false", value_start):
                value_end = value_start + len("false")
                if value_end >= defaults_end or not (
                    text[value_end].isalnum() or text[value_end] in "_$"
                ):
                    return text[:value_start] + "true" + text[value_end:]
            return text

        content_start = skip_ws_comments(text, defaults_start + 1, defaults_end)
        first_line_end = text.find("\n", content_start, defaults_end)
        if first_line_end == -1:
            first_line_end = defaults_end

        if content_start < defaults_end and text[content_start:first_line_end].strip():
            insert = '"skipBootstrapFile": true, '
            insert_at = content_start
        else:
            line_start = text.rfind(
                "\n", 0, content_start if content_start < defaults_end else defaults_start
            ) + 1
            indent_match = re.match(
                r"[ \t]*",
                text[line_start : content_start if content_start < defaults_end else defaults_start],
            )
            indent = indent_match.group(0) if indent_match else ""
            insert = f'\n{indent}  "skipBootstrapFile": true,'
            insert_at = content_start if content_start < defaults_end else defaults_start + 1
        return text[:insert_at] + insert + text[insert_at:]

    patched = ensure_agents_defaults_object(raw_text)
    bounds = find_agents_defaults_bounds(patched)
    if bounds is None:
        return patched
    defaults_start, defaults_end = bounds
    patched = replace_prefixed_string_property(patched, defaults_start, defaults_end, "workspace")

    bounds = find_agents_defaults_bounds(patched)
    if bounds is None:
        return patched
    defaults_start, defaults_end = bounds
    memory_search_start = find_direct_object_property_start(
        patched, defaults_start, defaults_end, "memorySearch"
    )
    if memory_search_start is not None and patched[memory_search_start] == "{":
        memory_search_end = find_matching_brace(patched, memory_search_start, defaults_end + 1)
        if memory_search_end is not None:
            local_start = find_direct_object_property_start(
                patched, memory_search_start, memory_search_end, "local"
            )
            if local_start is not None and patched[local_start] == "{":
                local_end = find_matching_brace(patched, local_start, memory_search_end + 1)
                if local_end is not None:
                    patched = replace_prefixed_string_property(
                        patched, local_start, local_end, "modelCacheDir"
                    )

    return force_skip_bootstrap_file_flag(patched)

try:
    patched = patch_agents_defaults_json5(raw)
    if patched != raw:
        with open(path, "w") as f:
            f.write(patched)
        print("changed")
    else:
        print("unchanged")
except OSError:
    print("error")
PY
}

sanitize_channel_config_if_present() {
  local channelId="$1"
  local configPath="$INSTANCES_DIR/$channelId/openclaw.json"
  if [ ! -f "$configPath" ]; then
    echo "missing"
    return 0
  fi
  sanitize_config_file "$configPath"
}

# Before removing a container whose old config pointed at /home/node/.openclaw,
# rescue any workspace/memory it wrote to that path. Older configs used an
# unmounted in-container path, so that data lives only in the container's writable
# layer and would be lost on `docker rm`. Copy it into the mounted instance dir
# (which maps to /root/.openclaw) so the repaired container keeps the memory.
preserve_legacy_container_data() {
  local channelId="$1"
  local destDir="$2"
  local container="agents.channel-$channelId"

  # docker cp works for stopped containers too; only skip when the container
  # itself no longer exists.
  if ! docker container inspect "$container" >/dev/null 2>&1; then
    return 0
  fi

  echo "Preserving legacy /home/node/.openclaw data for $channelId..."
  # Copy contents (not the dir itself) into the mounted instance dir, without
  # clobbering files that already exist there. Returns non-zero if either the
  # docker cp or the local copy fails, so callers can abort the destructive
  # container removal rather than losing the only copy of the legacy data.
  local tmp rc=0
  tmp=$(mktemp -d)
  if docker cp "$container:/home/node/.openclaw/." "$tmp/" 2>/dev/null; then
    # cp -Rn: never overwrite existing mounted files (mounted config wins).
    if cp -Rn "$tmp/." "$destDir/" 2>/dev/null; then
      echo "Preserved legacy data for $channelId."
    else
      echo "Error: failed to copy legacy data into $destDir for $channelId." >&2
      rc=1
    fi
  else
    echo "Error: failed to copy legacy data out of container for $channelId." >&2
    rc=1
  fi
  rm -rf "$tmp"
  return "$rc"
}

repair_existing_configs() {
  local restart_changed="${1:-false}"
  local fail_on_missing="${2:-false}"
  local preserve_changed="${3:-false}"
  local repaired=0
  local restarted=0
  local unchanged=0
  local missing=0
  local missing_unregistered=0
  local errored=0

  for dir in "$INSTANCES_DIR"/*/; do
    [ -d "$dir" ] || continue
    local channelId
    channelId=$(basename "$dir")

    local outcome
    outcome=$(sanitize_channel_config_if_present "$channelId")
    if [ "$outcome" = "changed" ]; then
      repaired=$((repaired + 1))
      echo "Repaired config for $channelId"
      local port=""
      port=$(get_port "$channelId")
      local preserve_ok="true"
      if [ -n "$port" ] && { [ "$preserve_changed" = "true" ] || [ "$restart_changed" = "true" ]; }; then
        if ! preserve_legacy_container_data "$channelId" "$dir"; then
          preserve_ok="false"
          errored=$((errored + 1))
        fi
      fi
      if [ "$restart_changed" = "true" ]; then
        if [ "$preserve_ok" != "true" ]; then
          # Do not destroy the container while its legacy data is unrecovered.
          echo "Error: skipping restart for $channelId; legacy data was not preserved." >&2
        elif [ -n "$port" ]; then
          echo "Restarting container for $channelId on port $port..."
          stop_container "$channelId"
          start_container "$channelId" "$port"
          restarted=$((restarted + 1))
        else
          echo "Config repaired for $channelId; no registered port, skipped restart."
        fi
      fi
    elif [ "$outcome" = "missing" ]; then
      if [ -n "$(get_port "$channelId")" ]; then
        missing=$((missing + 1))
        echo "Missing config for registered channel $channelId."
      else
        missing_unregistered=$((missing_unregistered + 1))
        echo "Skipped config repair for unregistered directory $channelId; openclaw.json is missing."
      fi
    elif [ "$outcome" = "error" ]; then
      # A read/write failure must not be silently counted as "unchanged" — that
      # would let boot start an unrepaired stale config.
      errored=$((errored + 1))
      echo "Error: failed to sanitize config for $channelId." >&2
    else
      unchanged=$((unchanged + 1))
    fi
  done

  echo "Done. repaired=$repaired restarted=$restarted unchanged=$unchanged missing=$missing missingUnregistered=$missing_unregistered errored=$errored"
  # Any error is fatal (so automation never treats an incomplete migration as
  # success); missing registered configs are fatal only for the boot path.
  local failed="false"
  if [ "$errored" -gt 0 ]; then
    echo "Error: $errored config(s) failed to sanitize or preserve legacy data." >&2
    failed="true"
  fi
  if [ "$fail_on_missing" = "true" ] && [ "$missing" -gt 0 ]; then
    echo "Error: missing openclaw.json for $missing registered instance(s)." >&2
    failed="true"
  fi
  if [ "$failed" = "true" ]; then
    return 1
  fi
}

cmd_sanitize_configs() {
  local preserve_changed="false"
  case "${1:-}" in
    "")
      ;;
    --preserve-legacy-data)
      preserve_changed="true"
      ;;
    *)
      echo "Usage: openclawctl sanitize-configs [--preserve-legacy-data]" >&2
      return 1
      ;;
  esac
  repair_existing_configs false true "$preserve_changed"
}

cmd_repair_configs() {
  repair_existing_configs true false
}

# --- Discord API helpers ---

get_discord_token() {
  if [ -n "${DISCORD_BOT_TOKEN:-}" ]; then
    echo "$DISCORD_BOT_TOKEN"
    return
  fi
  for dir in "$INSTANCES_DIR"/*/; do
    [ -d "$dir" ] || continue
    local token
    token=$(python3 -c "
import json
try:
    cfg = json.load(open('${dir}openclaw.json'))
    print(cfg.get('channels',{}).get('discord',{}).get('token',''))
except: pass
" 2>/dev/null)
    if [ -n "$token" ]; then
      echo "$token"
      return
    fi
  done
  echo ""
}

resolve_dm_channel() {
  local userId="$1"
  local token
  token=$(get_discord_token)
  if [ -z "$token" ]; then
    echo "Error: No Discord bot token found." >&2
    return 1
  fi
  local resp
  resp=$(curl -s -X POST "https://discord.com/api/v10/users/@me/channels" \
    -H "Authorization: Bot $token" \
    -H "Content-Type: application/json" \
    -d "{\"recipient_id\": \"$userId\"}")
  python3 -c "
import json, sys
try:
    data = json.loads('''$resp''')
    cid = data.get('id', '')
    if cid:
        print(cid)
    else:
        print('Error: Could not resolve DM channel.', file=sys.stderr)
        sys.exit(1)
except Exception as e:
    print(f'Error: {e}', file=sys.stderr)
    sys.exit(1)
"
}

# --- Container helpers ---

start_container() {
  local channelId="$1"
  local port="$2"
  local outcome
  outcome=$(sanitize_channel_config_if_present "$channelId")
  if [ "$outcome" = "changed" ]; then
    echo "Sanitized config for $channelId before start."
  elif [ "$outcome" = "missing" ]; then
    echo "Error: Missing config for $channelId at $INSTANCES_DIR/$channelId/openclaw.json" >&2
    return 1
  elif [ "$outcome" = "error" ]; then
    # Refuse to launch with a config we could not repair (it may still point at
    # the stale /home/node path).
    echo "Error: Could not sanitize config for $channelId; refusing to start." >&2
    return 1
  fi
  OPENCLAW_CHANNEL_ID="$channelId" OPENCLAW_CHANNEL_PORT="$port" \
    docker compose -f "$AGENT_YML" -p "agents-$channelId" up -d
}

stop_container() {
  local channelId="$1"
  local container="agents.channel-$channelId"
  docker stop "$container" 2>/dev/null && docker rm "$container" 2>/dev/null || true
}

# --- Commands ---

cmd_add_dm() {
  local userId="${1:-}"
  if [ -z "$userId" ]; then
    echo "Usage: openclawctl add-dm <userId>"
    exit 1
  fi

  echo "Resolving DM channel for user $userId..."
  local channelId
  channelId=$(resolve_dm_channel "$userId")
  echo "DM channel ID: $channelId"

  # Check if already registered
  local existing_port
  existing_port=$(get_port "$channelId")
  if [ -n "$existing_port" ]; then
    echo "Channel $channelId is already registered on port $existing_port."
    exit 0
  fi

  # Allocate port and register
  local port
  port=$(allocate_port)
  assign_port "$channelId" "$port"
  echo "Assigned port $port"

  # Create instance directory
  mkdir -p "$INSTANCES_DIR/$channelId"

  # Copy + sanitize openclaw.json from an existing instance. If provisioning
  # cannot produce a config, roll back the port assignment and instance dir so we
  # don't leave a half-registered channel that blocks retries.
  if ! provision_config "$channelId"; then
    echo "Rolling back registration for $channelId..." >&2
    free_port "$channelId"
    rmdir "$INSTANCES_DIR/$channelId" 2>/dev/null || true
    exit 1
  fi

  # Start container
  echo "Starting container agents.channel-$channelId on port $port..."
  start_container "$channelId" "$port"
  echo "Done. User $userId can now DM the bot."
}

cmd_add_channel() {
  local channelId="${1:-}"
  if [ -z "$channelId" ]; then
    echo "Usage: openclawctl add-channel <channelId>"
    exit 1
  fi

  local existing_port
  existing_port=$(get_port "$channelId")
  if [ -n "$existing_port" ]; then
    echo "Channel $channelId is already registered on port $existing_port."
    exit 0
  fi

  local port
  port=$(allocate_port)
  assign_port "$channelId" "$port"
  echo "Assigned port $port"

  mkdir -p "$INSTANCES_DIR/$channelId"

  # Copy + sanitize openclaw.json from an existing instance. Roll back on failure
  # so a channel that cannot be provisioned does not leave a stale port.
  if ! provision_config "$channelId"; then
    echo "Rolling back registration for $channelId..." >&2
    free_port "$channelId"
    rmdir "$INSTANCES_DIR/$channelId" 2>/dev/null || true
    exit 1
  fi

  echo "Starting container agents.channel-$channelId on port $port..."
  start_container "$channelId" "$port"
  echo "Done. Channel $channelId is now registered."
}

cmd_remove() {
  local channelId="${1:-}"
  if [ -z "$channelId" ]; then
    echo "Usage: openclawctl remove <channelId>"
    exit 1
  fi

  echo "Stopping container for channel $channelId..."
  stop_container "$channelId"

  echo "Freeing port..."
  free_port "$channelId"

  echo "Done. Instance data preserved at $INSTANCES_DIR/$channelId/"
  echo "To delete data: rm -rf $INSTANCES_DIR/$channelId"
}

cmd_restart() {
  local channelId="${1:-}"
  if [ -z "$channelId" ]; then
    echo "Usage: openclawctl restart <channelId>"
    exit 1
  fi

  local port
  port=$(get_port "$channelId")
  if [ -z "$port" ]; then
    echo "Error: Channel $channelId is not registered."
    exit 1
  fi

  # Sanitize before stopping so we can detect stale /home/node configs and rescue
  # legacy data from the old container writable layer before docker rm.
  local outcome
  outcome=$(sanitize_channel_config_if_present "$channelId")
  if [ "$outcome" = "missing" ]; then
    echo "Error: Missing config for $channelId at $INSTANCES_DIR/$channelId/openclaw.json" >&2
    exit 1
  elif [ "$outcome" = "error" ]; then
    # Refuse to stop/remove the container with an unrepaired config; that would
    # both restart stale and risk discarding legacy data.
    echo "Error: Could not sanitize config for $channelId; refusing to restart." >&2
    exit 1
  fi

  echo "Restarting container for channel $channelId on port $port..."
  if [ "$outcome" = "changed" ]; then
    if ! preserve_legacy_container_data "$channelId" "$INSTANCES_DIR/$channelId"; then
      # Do not destroy the container while its legacy data is unrecovered.
      echo "Error: legacy data not preserved for $channelId; aborting restart." >&2
      exit 1
    fi
  fi
  stop_container "$channelId"
  start_container "$channelId" "$port"
  echo "Done."
}

cmd_list() {
  ensure_ports_file
  python3 -c "
import json, subprocess
ports = json.load(open('$PORTS_FILE'))
assignments = ports.get('assignments', {})
base = ports.get('basePort', 18789)

print('Registered channels:')
print()
if not assignments:
    print('  (none)')
else:
    for cid, port in sorted(assignments.items(), key=lambda x: x[1]):
        result = subprocess.run(
            ['docker', 'inspect', '-f', '{{.State.Status}}', f'agents.channel-{cid}'],
            capture_output=True, text=True
        )
        status = result.stdout.strip() if result.returncode == 0 else 'not found'
        print(f'  {cid}  port={port}  status={status}')

# Show port summary
used = set(assignments.values())
max_port = max(used) if used else base - 1
gaps = [p for p in range(base, max_port + 1) if p not in used]
print()
print(f'Port range: {base}-{max_port} ({len(assignments)} used)')
if gaps:
    print(f'Available ports (gaps): {gaps}')
print(f'Next port: {max_port + 1 if not gaps else min(gaps)}')
"
}

cmd_reconcile() {
  ensure_ports_file
  echo "Reconciling ports.json with instance directories..."
  reconcile_ports
}

# --- Main ---

ensure_ports_file

case "${1:-}" in
  add-dm)      cmd_add_dm "${2:-}" ;;
  add-channel) cmd_add_channel "${2:-}" ;;
  remove)      cmd_remove "${2:-}" ;;
  restart)     cmd_restart "${2:-}" ;;
  list)        cmd_list ;;
  reconcile)   cmd_reconcile ;;
  sanitize-configs) cmd_sanitize_configs "${2:-}" ;;
  repair-configs) cmd_repair_configs ;;
  *)
    echo "openclawctl — Manage OpenClaw agent containers"
    echo ""
    echo "Commands:"
    echo "  add-dm <userId>         Register a DM channel for a Discord user"
    echo "  add-channel <channelId> Register a text channel"
    echo "  remove <channelId>      Stop and deregister a channel"
    echo "  restart <channelId>     Restart a channel's container"
    echo "  list                    List all registered channels and ports"
    echo "  reconcile               Sync ports.json with instance directories"
    echo "  sanitize-configs [--preserve-legacy-data]  Rewrite stale copied configs without restarting containers"
    echo "  repair-configs          Rewrite stale copied configs and restart changed channels"
    ;;
esac
