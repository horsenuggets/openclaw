#!/usr/bin/env bash
# openclawctl — Management script for OpenClaw channel-based agent containers.
# Runs on the WSL host. Manages the port registry, instance directories,
# and Docker containers for per-channel agents.
set -euo pipefail

# Load ~/.env so manual invocations see the same config the provisioner daemon
# gets via its systemd EnvironmentFile (agent-bridge settings, proxy gateway IP,
# etc.). Harmless when already inherited; required when run by hand.
if [ -f "$HOME/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$HOME/.env"
  set +a
fi

INSTANCES_DIR="$HOME/.openclaw-instances"
AGENT_YML="$HOME/deploy/docker/agent.yml"

# Agent bridge network (see agent.yml / boot.sh). Boxes join this user-defined
# bridge instead of the host network, so each is isolated to the two router
# proxies (at the gateway IP) plus outbound internet. Name + subnet come from
# ~/.env (no defaults) so openclawctl can create the network if a channel is
# registered before boot.sh has run. The gateway IP is validated lower down where
# the proxy URLs are built.
: "${OPENCLAW_AGENT_NETWORK:?OPENCLAW_AGENT_NETWORK must be set in ~/.env (agent bridge name, e.g. oc-agents)}"
: "${OPENCLAW_AGENT_SUBNET:?OPENCLAW_AGENT_SUBNET must be set in ~/.env (agent bridge subnet, e.g. 172.30.0.0/24)}"
# Single shared auth-profiles store mounted into every agent container (see
# infrastructure/docker/agent.yml). OAuth refresh tokens rotate, so a
# per-instance copy goes stale; sharing one file lets a refresh in any instance
# be seen by all. Must exist as a regular file before a container starts, or
# Docker would bind-mount it as an empty directory.
SHARED_AUTH_DIR="$INSTANCES_DIR/shared/auth"
SHARED_AUTH_FILE="$SHARED_AUTH_DIR/auth-profiles.json"
# Lowest port to hand out. Mirrors DEFAULT_GATEWAY_PORT in src/config/paths.ts
# (a shell script cannot import the TypeScript constant).
BASE_PORT=18789
# Per-instance port file, relative to each instance directory. Mirrors
# PORT_FILENAME in src/discord/router/config.ts.
PORT_FILENAME=".port"
PORT_LOCK_FILE="$INSTANCES_DIR/.port.lock"

# Locate the openclaw CLI. deploy.sh installs it alongside this script in
# ~/deploy/bin, so prefer the sibling binary; fall back to PATH. Used for
# JSON5-aware config edits (config set) so we don't hand-roll a JSON5 parser.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -x "$SCRIPT_DIR/openclaw" ]; then
  OPENCLAW_BIN="$SCRIPT_DIR/openclaw"
else
  OPENCLAW_BIN="$(command -v openclaw || true)"
fi

# Ensure instances directory exists
mkdir -p "$INSTANCES_DIR"

# Reject anything that is not a Discord snowflake (17-20 digits) before it is
# ever used to build a filesystem path. This mirrors the router's directory
# filter and prevents a value like `../foo` from touching files outside
# $INSTANCES_DIR.
require_channel_id() {
  case "$1" in
    "" ) echo "Error: channel/DM id required." >&2; exit 1 ;;
  esac
  if ! printf '%s' "$1" | grep -Eq '^[0-9]{17,20}$'; then
    echo "Error: invalid channel id '$1' (expected a 17-20 digit Discord id)." >&2
    exit 1
  fi
}

# --- Port helpers ---
#
# Each instance owns its port as a plain-integer dotfile inside its own
# directory ($INSTANCES_DIR/<channelId>/.port). There is no central registry,
# so a port cannot drift from its instance and removing the directory removes
# the port. Allocation scans the dotfiles to find what is taken.

port_file() {
  echo "$INSTANCES_DIR/$1/$PORT_FILENAME"
}

# Parse a raw .port value to a canonical positive decimal port, or empty.
# Mirrors the router's rule: trim surrounding whitespace (like the TS/Python
# readers' .strip()/.trim()), require all ASCII digits, value > 0, and
# normalize leading zeros (`10#` forces base-10) so `018789` == `18789`.
# Always returns success so a malformed .port can't abort callers under set -e.
parse_port() {
  local raw n
  raw=$(printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  printf '%s' "$raw" | grep -Eq '^[0-9]+$' || return 0
  n=$((10#$raw))
  if [ "$n" -gt 0 ]; then
    echo "$n"
  fi
  return 0
}

# Read an instance's port as a canonical positive integer (empty if unset/invalid).
get_port() {
  local file
  file=$(port_file "$1")
  [ -f "$file" ] || return 0
  parse_port "$(cat "$file")"
}

# Collect every port currently claimed by an instance dotfile (canonicalized).
used_ports() {
  local f owner p
  for f in "$INSTANCES_DIR"/*/"$PORT_FILENAME"; do
    [ -f "$f" ] || continue
    p=$(parse_port "$(cat "$f")")
    [ -n "$p" ] && echo "$p"
  done
}

# Ports actually bound right now. Each agent gateway opens its primary port
# (from .port) plus a secondary listener on a port it picks dynamically at
# startup, and those secondaries are NOT recorded in any .port file. Allocating
# only around .port files therefore hands out a port a neighbour already holds,
# and the new agent crash-loops on bind. So allocation also skips every port
# that is currently listening.
listening_ports() {
  ss -ltnH 2>/dev/null | awk '{print $4}' | sed -E 's/.*:([0-9]+)$/\1/' | grep -E '^[0-9]+$'
}

allocate_port() {
  local used port
  used=$(printf '%s\n%s\n' "$(used_ports)" "$(listening_ports)" | sort -u)
  port=$BASE_PORT
  while echo "$used" | grep -qx "$port"; do
    port=$((port + 1))
  done
  echo "$port"
}

# Reserve a port for a channel while holding an exclusive lock so concurrent
# add-* invocations cannot both claim the same free port.
reserve_port() {
  local channelId="$1"
  (
    flock 9

    local existing_port port
    existing_port=$(get_port "$channelId")
    if [ -n "$existing_port" ]; then
      echo "ERROR: channel $channelId already assigned to port $existing_port" >&2
      exit 2
    fi

    port=$(allocate_port)
    assign_port "$channelId" "$port"
    echo "$port"
  ) 9>"$PORT_LOCK_FILE"
}

# Write a port to an instance's dotfile (atomic), refusing to reuse a port
# already claimed by a different instance.
assign_port() {
  local channelId="$1"
  local port="$2"
  local f p
  port=$(parse_port "$port")
  if [ -z "$port" ]; then
    echo "ERROR: invalid port '$2'" >&2
    return 1
  fi
  for f in "$INSTANCES_DIR"/*/"$PORT_FILENAME"; do
    [ -f "$f" ] || continue
    local owner
    owner=$(basename "$(dirname "$f")")
    [ "$owner" = "$channelId" ] && continue
    p=$(get_port "$owner")
    if [ "$p" = "$port" ]; then
      echo "ERROR: port $port already assigned to $owner" >&2
      return 1
    fi
  done
  local dst tmp
  dst=$(port_file "$channelId")
  mkdir -p "$(dirname "$dst")"
  tmp="${dst}.tmp.$$"
  echo "$port" > "$tmp"
  mv "$tmp" "$dst"
}

# Deregister a channel by removing its port dotfile (instance data is kept).
free_port() {
  rm -f "$(port_file "$1")"
}

# --- Discord API helpers ---

get_discord_token() {
  # Durable source: DISCORD_BOT_TOKEN from ~/.env (exported by boot.sh / the
  # provisioner systemd unit's EnvironmentFile). The per-instance openclaw.json
  # scan below is only a legacy fallback for hosts predating that convention.
  if [ -n "${DISCORD_BOT_TOKEN:-}" ]; then
    echo "$DISCORD_BOT_TOKEN"
    return
  fi
  for dir in "$INSTANCES_DIR"/[0-9]*; do
    # Match the router/boot/shared-auth boundary: only scan real numeric
    # instance dirs, never symlinks.
    if [ ! -d "$dir" ] || [ -L "$dir" ]; then
      continue
    fi
    local token
    token=$(python3 -c "
import json
try:
    cfg = json.load(open('${dir}/openclaw.json'))
    print(cfg.get('channels',{}).get('discord',{}).get('token',''))
except: pass
" 2>/dev/null)
    if [ -n "$token" ]; then
      echo "$token"
      return
    fi
  done
  echo ""
}

resolve_dm_channel() {
  local userId="$1"
  local token
  token=$(get_discord_token)
  if [ -z "$token" ]; then
    echo "Error: No Discord bot token found." >&2
    return 1
  fi
  local resp
  resp=$(curl -s -X POST "https://discord.com/api/v10/users/@me/channels" \
    -H "Authorization: Bot $token" \
    -H "Content-Type: application/json" \
    -d "{\"recipient_id\": \"$userId\"}")
  python3 -c "
import json, sys
try:
    data = json.loads('''$resp''')
    cid = data.get('id', '')
    if cid:
        print(cid)
    else:
        print('Error: Could not resolve DM channel.', file=sys.stderr)
        sys.exit(1)
except Exception as e:
    print(f'Error: {e}', file=sys.stderr)
    sys.exit(1)
"
}

# --- Container helpers ---

# Ensure the shared auth-profiles file exists as a regular file. It is the single
# store of the REAL provider OAuth token and is read by the router's model proxy
# (createSharedAuthTokenResolver) to inject the bearer on behalf of token-free
# boxes. It is NOT mounted into any container. Seeds from an existing per-instance
# auth store (one-time migration off the old copy-per-instance model) or an empty
# store, so a fresh host still comes up cleanly. Idempotent: never clobbers an
# existing shared file (that file is the live, rotating source of truth).
#
# Runs the check+seed under the same $PORT_LOCK_FILE lock reserve_port uses, so
# two concurrent `add-*` invocations on a fresh host can't both see the file
# missing and race to write it. Skips symlinked instance directories to honour
# the no-symlink boundary the router (Dirent.isDirectory) and boot.sh apply —
# a numeric symlink could otherwise seed secrets from a path outside the
# intended instances tree.
ensure_shared_auth() {
  (
    flock 9
    # The shared auth store holds the real OAuth refresh token, so require it to be
    # a real regular file. Reject a symlink (which -f/-e would silently follow,
    # letting the store be redirected outside the instances tree) and reject a
    # non-file such as a stray directory. Fail fast rather than cp'ing *into* it.
    if [ -L "$SHARED_AUTH_FILE" ] || { [ -e "$SHARED_AUTH_FILE" ] && [ ! -f "$SHARED_AUTH_FILE" ]; }; then
      echo "ERROR: $SHARED_AUTH_FILE must be a regular file, not a symlink or directory (e.g. a Docker-created bind-mount dir)." >&2
      echo "       Stop the agent containers, remove that path, and re-run so it can be seeded as a file." >&2
      exit 1
    fi
    [ -f "$SHARED_AUTH_FILE" ] && exit 0
    mkdir -p "$SHARED_AUTH_DIR"
    chmod 700 "$SHARED_AUTH_DIR" 2>/dev/null || true
    local instdir existing
    for instdir in "$INSTANCES_DIR"/[0-9]*; do
      # Require a real directory, not a symlink, matching the router's boundary.
      if [ ! -d "$instdir" ] || [ -L "$instdir" ]; then
        continue
      fi
      existing="$instdir/agents/main/agent/auth-profiles.json"
      [ -f "$existing" ] || continue
      cp "$existing" "$SHARED_AUTH_FILE"
      chmod 600 "$SHARED_AUTH_FILE" 2>/dev/null || true
      echo "Seeded shared auth from $existing"
      exit 0
    done
    # No existing profiles to migrate; write an empty store matching the shape
    # src/agents/auth-profiles expects (version + profiles map).
    printf '{\n  "version": 1,\n  "profiles": {}\n}\n' > "$SHARED_AUTH_FILE"
    chmod 600 "$SHARED_AUTH_FILE" 2>/dev/null || true
  ) 9>"$PORT_LOCK_FILE"
}

# Create the agent bridge if absent, with the fixed subnet/gateway from ~/.env.
# agent.yml references it as an external network, so it must exist before a box
# starts. boot.sh creates it at startup too; this covers a channel registered at
# runtime before a reboot. The bridge is created with inter-container communication
# disabled (enable_icc=false) so a box cannot reach a sibling box over the shared
# bridge; each box still reaches the router proxies (at the gateway IP) and the
# internet (NAT), and the host-networked router still reaches each box's published
# gateway port. When the network already exists, validate its driver/subnet/gateway
# AND that icc is disabled: a stale bridge left over from an earlier .env or from the
# pre-isolation layout (docker does not update options/IPAM on an existing network,
# and setup.sh removes containers but not networks) would leave boxes able to reach
# each other or on the wrong subnet, so fail with remediation instead of silently
# proceeding.
ensure_agent_network() {
  if docker network inspect "$OPENCLAW_AGENT_NETWORK" >/dev/null 2>&1; then
    if ! docker network inspect "$OPENCLAW_AGENT_NETWORK" | validate_agent_network; then
      echo "ERROR: existing docker network '$OPENCLAW_AGENT_NETWORK' does not match the" >&2
      echo "  configured driver=bridge subnet=$OPENCLAW_AGENT_SUBNET gateway=$OPENCLAW_AGENT_GATEWAY" >&2
      echo "  with inter-container communication disabled (enable_icc=false)." >&2
      echo "  Stop the agent boxes and remove it so it can be recreated:" >&2
      echo "    docker network rm $OPENCLAW_AGENT_NETWORK" >&2
      exit 1
    fi
    return 0
  fi
  echo "Creating agent bridge $OPENCLAW_AGENT_NETWORK ($OPENCLAW_AGENT_SUBNET, gw $OPENCLAW_AGENT_GATEWAY, icc off)..."
  docker network create --driver bridge \
    -o com.docker.network.bridge.enable_icc=false \
    --subnet "$OPENCLAW_AGENT_SUBNET" \
    --gateway "$OPENCLAW_AGENT_GATEWAY" \
    "$OPENCLAW_AGENT_NETWORK"
}

# Read `docker network inspect` JSON on stdin and exit nonzero unless the network's
# driver is bridge, its first IPAM config matches OPENCLAW_AGENT_SUBNET /
# OPENCLAW_AGENT_GATEWAY, and inter-container communication is disabled
# (com.docker.network.bridge.enable_icc=false). Shared by the ensure path above.
validate_agent_network() {
  python3 -c '
import json, os, sys

net = json.load(sys.stdin)[0]
cfg = ((net.get("IPAM") or {}).get("Config") or [{}])[0]
icc = (net.get("Options") or {}).get("com.docker.network.bridge.enable_icc")
ok = (
    net.get("Driver") == "bridge"
    and cfg.get("Subnet") == os.environ["OPENCLAW_AGENT_SUBNET"]
    and cfg.get("Gateway") == os.environ["OPENCLAW_AGENT_GATEWAY"]
    and icc == "false"
)
if not ok:
    sys.stderr.write(
        f"  found driver={net.get('Driver')} subnet={cfg.get('Subnet')} "
        f"gateway={cfg.get('Gateway')} enable_icc={icc}\n"
    )
sys.exit(0 if ok else 1)
'
}

start_container() {
  local channelId="$1"
  local port="$2"
  # ensure_shared_auth captures any legacy real token into the shared store BEFORE
  # prepare_instance_dirs migrates/overwrites the per-instance auth with the
  # placeholder, so the real credential is never lost nor left inside the box.
  ensure_shared_auth
  # The box joins the external oc-agents bridge; make sure it exists first.
  ensure_agent_network
  prepare_instance_dirs "$channelId"
  OPENCLAW_CHANNEL_ID="$channelId" OPENCLAW_CHANNEL_PORT="$port" \
    docker compose -f "$AGENT_YML" -p "agents-$channelId" up -d
}

stop_container() {
  local channelId="$1"
  local container="agents.channel-$channelId"
  docker stop "$container" 2>/dev/null && docker rm "$container" 2>/dev/null || true
}

# Seed the agent workspace (BOOTSTRAP.md + SOUL/USER/AGENTS/etc. templates) inside
# the freshly-started container. The onboarding wizard normally seeds these, but
# the provisioning path bypasses the wizard, so the workspace would otherwise stay
# empty until the agent's first turn seeds it lazily. That is too late for the
# router: it reads workspace/BOOTSTRAP.md to drive the first-run welcome card on
# registration, so a missing file means no welcome and no onboarding. Runs on the
# HOST using the deploy binary (deploy.sh stages the hand-picked templates next to
# it at ~/deploy/bin/docs/reference/templates), so the box needs no docs mount.
# Idempotent: setup uses write-if-missing, so re-running on an existing instance
# is a no-op.
# Debug toggle (mirror rig only): when OPENCLAW_SKIP_BOOTSTRAP is truthy, drop just
# the first-run BOOTSTRAP.md after seeding so the agent keeps its full persona
# (SOUL.md et al.) but skips the first-run onboarding ritual the router drives off
# BOOTSTRAP.md. This is deliberately narrower than agents.defaults.skipBootstrap,
# which suppresses every workspace file and leaves the agent persona-less. Default
# off so the onboarding path is exercised like prod; flip it in .env.mirror for a
# quick functional test that should not pay the name-dance.
skip_bootstrap_enabled() {
  case "$(printf '%s' "${OPENCLAW_SKIP_BOOTSTRAP:-}" | tr '[:upper:]' '[:lower:]')" in
    1 | true | yes | on) return 0 ;;
    *) return 1 ;;
  esac
}

seed_workspace() {
  local channelId="$1"
  local ws="$INSTANCES_DIR/$channelId/workspace"
  # Seed on the HOST, not via `docker exec`: the deploy binary ships the
  # hand-picked workspace templates next to itself (deploy.sh stages
  # docs/reference/templates into ~/deploy/bin/docs), so `openclaw setup` resolves
  # them with no docs mount in the box at all. Host-side seeding also readies the
  # workspace independently of the container, and keeps the box image docs-free.
  # Idempotent: setup is write-if-missing.
  # Run under a throwaway HOME/config: `openclaw setup` also updates
  # agents.defaults.workspace and touches ~/.openclaw, which we must NOT let it do
  # to the host's global config. Isolating HOME sends those incidental writes to a
  # temp dir; only the --workspace seeding persists (templates resolve next to the
  # binary, independent of HOME).
  local setup_home ok=0
  setup_home="$(mktemp -d)"
  if HOME="$setup_home" OPENCLAW_CONFIG_PATH="$setup_home/openclaw.json" \
    "$OPENCLAW_BIN" setup --workspace "$ws" >/dev/null 2>&1; then
    ok=1
  fi
  rm -rf "$setup_home"
  if [ "$ok" -ne 1 ]; then
    # Not fatal to registration: the agent seeds the workspace lazily on the first
    # user turn, so onboarding still runs then — only the proactive welcome-on-
    # register is lost until that first message.
    echo "Warning: could not seed workspace for $channelId; first-run welcome will" >&2
    echo "  be deferred to the first user message." >&2
    return 1
  fi
  if skip_bootstrap_enabled; then
    # Drop the first-run ritual file so onboarding does not fire (mirror rig only).
    # If it cannot be removed, do NOT claim success: the router would still launch
    # onboarding despite the toggle.
    if ! rm -f "$ws/BOOTSTRAP.md" 2>/dev/null || [ -e "$ws/BOOTSTRAP.md" ]; then
      echo "Warning: could not drop BOOTSTRAP.md for $channelId despite OPENCLAW_SKIP_BOOTSTRAP" >&2
      return 1
    fi
  fi
  # setup ran as the host user, so hand the workspace (including the .git repo it
  # creates) to the box uid or the read-only-rootfs box cannot write it.
  chown -R "$AGENT_UID:$AGENT_GID" "$ws" 2>/dev/null || true
  return 0
}

# Agent boxes run on the oc-agents bridge (see agent.yml), so they reach the
# router's two proxies at the bridge gateway IP, where the host-networked router
# binds them (OPENCLAW_PROXY_BIND). OPENCLAW_AGENT_GATEWAY is the single source of
# truth for that IP, shared with boot.sh via ~/.env. No default: a missing value
# is a deploy error, not a guessed address.
: "${OPENCLAW_AGENT_GATEWAY:?OPENCLAW_AGENT_GATEWAY must be set in ~/.env (agent bridge gateway IP, e.g. 172.30.0.1)}"

# The router's container proxy (startContainerProxyServer, PROXY_PORT). Boxes POST
# proactive/heartbeat Discord sends here.
CONTAINER_PROXY_URL="http://$OPENCLAW_AGENT_GATEWAY:18800"

# The router's model proxy (startModelProxyServer). Boxes point their provider
# baseUrl here and send only a placeholder token; the proxy injects the real
# (refreshed) OAuth bearer, so no provider credential ever lives in a box. Port
# must match MODEL_PROXY_PORT in src/discord/router/model-proxy.ts.
MODEL_PROXY_URL="http://$OPENCLAW_AGENT_GATEWAY:18702"

# The agent container runs as this non-root uid:gid (see agent.yml). Its writable
# mounts (workspace, state) must be owned by it or writes fail on the read-only
# rootfs box.
AGENT_UID=1000
AGENT_GID=1000

# Per-instance marker written by prepare_instance_dirs once an instance is adopted
# into the token-free layout. Its presence gates starting an instance under the new
# agent.yml, so legacy (unprepared) instances are skipped rather than broken.
LAYOUT_MARKER=".token-free"

# Canonical profile id the gateway resolves for the anthropic-subscription
# provider (matches ANTHROPIC_SUBSCRIPTION_PROFILE_ID in the source and what
# `openclaw auth mint-anthropic` writes), so a config referencing it still
# resolves the placeholder.
PLACEHOLDER_OAUTH_PROFILE_ID="anthropic-subscription:default"

# Placeholder OAuth access token seeded into each box. It makes pi-ai build a
# subscription-shaped request without the box ever holding a real credential; the
# model proxy replaces the bearer upstream. Intentionally NOT a secret. expires is
# set far in the future so the box never attempts a refresh of its own.
PLACEHOLDER_OAUTH_ACCESS="sk-ant-oat01-PLACEHOLDER-INJECTED-BY-ROUTER-MODEL-PROXY"
PLACEHOLDER_OAUTH_EXPIRES="4102444800000"

# Default primary model for a freshly-bootstrapped instance, used only when there
# is no sibling instance to copy config from. Must match the model id seeded into
# the anthropic-subscription provider block below.
BASE_MODEL="anthropic-subscription/claude-sonnet-4-6"

# Build a new instance's openclaw.json from an allowlist of the non-secret settings
# a token-free box needs (gateway mode + a fresh per-instance auth token, model
# selection, /workspace, the Discord send proxy, and the anthropic-subscription
# provider block). Written as RAW JSON, deliberately NOT via `openclaw config set`:
# config set loads the fully-resolved config, whose defaults pull host credentials
# (e.g. talk.apiKey from ELEVENLABS_API_KEY or the host shell profiles) and would
# persist them into the box-readable config. Does not copy a sibling config either.
# Fail-closed: returns nonzero if the config cannot be written, and callers abort
# rather than start a box with a missing or stale config.
seed_instance_config() {
  local channelId="$1"
  local target="$INSTANCES_DIR/$channelId/openclaw.json"

  # Always start fresh so a removed-then-re-added channel (data dir preserved by
  # `remove`) cannot reuse a retained, possibly secret-bearing config. The config
  # lives on the host instances tree (not box-writable), so rm -f is safe.
  rm -f "$target"
  echo "Seeding base config for $channelId"
  OPENCLAW_MODEL_PROXY_URL="$MODEL_PROXY_URL" \
    OPENCLAW_CONTAINER_PROXY_URL="$CONTAINER_PROXY_URL" \
    OPENCLAW_BASE_MODEL="$BASE_MODEL" \
    python3 - "$target" <<'PY'
import json, os, secrets, sys

target = sys.argv[1]
cfg = {
    "gateway": {"mode": "local", "auth": {"token": secrets.token_hex(16)}},
    "agents": {
        "defaults": {
            "model": {"primary": os.environ["OPENCLAW_BASE_MODEL"]},
            "workspace": "/workspace",
        }
    },
    # The box reaches Discord only through the router's container proxy.
    "channels": {"discord": {"proxyUrl": os.environ["OPENCLAW_CONTAINER_PROXY_URL"]}},
    # Point at the router's model proxy, not the Anthropic API directly; the proxy
    # injects the real OAuth bearer so the box never holds a provider credential.
    # The headers are the non-secret Claude Code user-agent + beta flags that bill
    # the request to the subscription. Defining the provider here is required or the
    # model resolves as "Unknown model" (it is not built into the binary).
    "models": {
        "providers": {
            "anthropic-subscription": {
                "baseUrl": os.environ["OPENCLAW_MODEL_PROXY_URL"],
                "api": "anthropic-messages",
                "auth": "oauth",
                "headers": {
                    "user-agent": "claude-cli/2.1.119 (external, cli)",
                    "anthropic-beta": "claude-code-20250219,oauth-2025-04-20,interleaved-thinking-2025-05-14,fine-grained-tool-streaming-2025-05-14",
                },
                "models": [
                    {
                        "id": "claude-sonnet-4-6",
                        "name": "Claude Sonnet 4.6",
                        "reasoning": False,
                        "input": ["text", "image"],
                        # The model proxy is a trusted route to Anthropic (it
                        # injects the real subscription OAuth bearer), so opt this
                        # model in to Anthropic's native server-side web search.
                        # The gate otherwise rejects the non-api.anthropic.com
                        # proxy baseUrl and would fall back to the Brave client
                        # tool (which these boxes have no key for).
                        "supportsAnthropicServerWebSearch": True,
                        "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
                        "contextWindow": 200000,
                        "maxTokens": 64000,
                    }
                ],
            }
        }
    },
}
# Create 0600 from the outset (not the deploy user's umask) so other host users
# cannot read gateway.auth.token before the later chown runs.
fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    json.dump(cfg, f, indent=2)
    f.write("\n")
PY
}

# Re-assert the box-side values a changed deploy must reach existing prepared
# instances on restart: the Discord send proxy, the model proxy baseUrl, and the
# /workspace path. Edits the raw JSON directly (NOT `openclaw config set`, which
# would resolve+persist host credential defaults). Only ever runs on prepared boxes
# whose config this script wrote as plain JSON, so json.load is safe.
force_box_config() {
  local target="$1"
  # A missing config is a failure, not a silent no-op: callers that reconcile an
  # instance before starting it must be able to tell the rewrite did not happen.
  if [ ! -f "$target" ]; then
    echo "Error: box config $target not found; cannot re-assert proxy URLs" >&2
    return 1
  fi
  # No 2>/dev/null: callers treat a nonzero exit as fatal, so let Python's error
  # (bad JSON, permission/ownership, disk full) reach stderr for diagnosis.
  if ! OPENCLAW_MODEL_PROXY_URL="$MODEL_PROXY_URL" \
    OPENCLAW_CONTAINER_PROXY_URL="$CONTAINER_PROXY_URL" \
    python3 - "$target" <<'PY'
import json, os, stat, sys, tempfile

target = sys.argv[1]
st = os.stat(target)
if not stat.S_ISREG(st.st_mode):
    sys.exit(f"refusing to rewrite {target}: not a regular file")
with open(target) as f:
    cfg = json.load(f)
cfg.setdefault("channels", {}).setdefault("discord", {})["proxyUrl"] = os.environ[
    "OPENCLAW_CONTAINER_PROXY_URL"
]
sub_provider = cfg.setdefault("models", {}).setdefault("providers", {}).setdefault(
    "anthropic-subscription", {}
)
sub_provider["baseUrl"] = os.environ["OPENCLAW_MODEL_PROXY_URL"]
# Opt the proxied subscription model in to Anthropic's native server-side web
# search. The model proxy is a trusted route to Anthropic, but its baseUrl is not
# api.anthropic.com, so without this flag the native-search gate rejects it and
# falls back to the keyless-on-these-boxes Brave client tool. Reconcile existing
# prepared instances too, not just freshly provisioned ones.
for model in sub_provider.get("models") or []:
    if isinstance(model, dict) and model.get("id") == "claude-sonnet-4-6":
        model["supportsAnthropicServerWebSearch"] = True
cfg.setdefault("agents", {}).setdefault("defaults", {})["workspace"] = "/workspace"
# Write atomically: stage the full JSON in a same-directory temp file, then
# os.replace() it onto the target, so a partial write (full disk, crash) never
# truncates the existing config. The config is kept mode 0600 (it holds
# gateway.auth.token) and its original owner, because the box mounts it read-only
# as the agent uid: a replacement owned by anyone else would be unreadable there.
# If ownership cannot be preserved we abort and leave the original intact rather
# than install an unreadable config.
fd, tmp = tempfile.mkstemp(
    dir=os.path.dirname(target) or ".", prefix=".openclaw.json.", suffix=".tmp"
)
try:
    os.fchmod(fd, 0o600)
    if (st.st_uid, st.st_gid) != (os.geteuid(), os.getegid()):
        os.fchown(fd, st.st_uid, st.st_gid)  # raises if not permitted -> abort below
    with os.fdopen(fd, "w") as f:
        fd = -1  # the file object now owns the descriptor; avoid a double close
        json.dump(cfg, f, indent=2)
        f.write("\n")
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, target)
except BaseException:
    if fd != -1:
        os.close(fd)
    try:
        os.unlink(tmp)
    except OSError:
        pass
    raise
PY
  then
    echo "Error: could not re-assert box config in $target; left unchanged" >&2
    return 1
  fi
}

# Idempotent per-instance preparation for the token-free layout. Scoped to NEW
# instances created on or after this change; migrating pre-existing instances (old
# state tree, legacy secrets in copied configs) is handled separately so it can be
# designed safely. Creates the writable /workspace and /state mounts, seeds the
# placeholder OAuth profile, re-asserts the proxy URLs, and fixes ownership for the
# non-root container uid.
prepare_instance_dirs() {
  local channelId="$1"
  local base="$INSTANCES_DIR/$channelId"
  local agent_dir="$base/state/agents/main/agent"
  # `home` is the box's real HOME mount (see agent.yml): a writable, persistent,
  # per-channel home so the agent behaves like a normal shell and $HOME-based tool
  # creds (e.g. gog's ~/.config/gogcli) persist here instead of in /state.
  mkdir -p "$base/workspace" "$base/home" "$agent_dir"

  # Seed the placeholder OAuth profile under the canonical profile id so a config
  # referencing it resolves. The box runs token-free: it needs *a* bearer so pi-ai
  # builds a subscription-shaped request, but the real token lives only in the
  # shared store the router reads — the model proxy swaps the placeholder upstream.
  # Written only when absent: a fresh instance has no auth file, and not rewriting
  # on restart avoids following any path a running box may have planted under
  # /state.
  local auth_file="$agent_dir/auth-profiles.json"
  if [ ! -f "$auth_file" ]; then
    cat > "$auth_file" <<JSON
{
  "version": 1,
  "profiles": {
    "$PLACEHOLDER_OAUTH_PROFILE_ID": {
      "type": "oauth",
      "provider": "anthropic-subscription",
      "access": "$PLACEHOLDER_OAUTH_ACCESS",
      "refresh": "",
      "expires": $PLACEHOLDER_OAUTH_EXPIRES
    }
  }
}
JSON
  fi

  # Re-assert the proxy URLs and /workspace path so a changed model-proxy port or
  # layout reaches the box on restart, not just on first add. The config already
  # exists here (add seeds it before this runs; restart requires it), so a failure
  # means a real write problem (disk full, permissions, bad ownership) and we must
  # NOT go on to start the box with a stale/unreachable config: fail loudly so the
  # add/restart aborts, leaving the original config intact.
  if ! force_box_config "$base/openclaw.json"; then
    echo "Error: could not reconcile proxy URLs in $base/openclaw.json; not starting $channelId" >&2
    return 1
  fi

  # The container runs as AGENT_UID:AGENT_GID; its writable mounts must be owned by
  # that uid or writes fail on the read-only-rootfs box.
  chown -R "$AGENT_UID:$AGENT_GID" "$base/workspace" "$base/state" "$base/home" 2>/dev/null || true

  # `openclaw config set` writes openclaw.json mode 600 (root-owned). The box
  # mounts it read-only and runs as AGENT_UID, so hand ownership to that uid or the
  # gateway crash-loops on "EACCES ... openclaw.json". Keeping it 600 (owner-only)
  # means it is not world-readable on the host tree.
  if [ -f "$base/openclaw.json" ]; then
    chown "$AGENT_UID:$AGENT_GID" "$base/openclaw.json" 2>/dev/null || true
  fi

  # Mark the instance as adopted into the token-free layout. boot.sh and restart
  # start an instance under the new agent.yml only when this marker is present, so
  # pre-existing (legacy) instances are never mounted into the new layout and
  # broken; they are skipped with a re-register hint until the migration follow-up.
  touch "$base/$LAYOUT_MARKER" 2>/dev/null || true
}

# True when an instance has been prepared for the token-free layout.
is_prepared() {
  [ -f "$INSTANCES_DIR/$1/$LAYOUT_MARKER" ]
}

# --- Commands ---

cmd_add_dm() {
  local userId="${1:-}"
  if [ -z "$userId" ]; then
    echo "Usage: openclawctl add-dm <userId>"
    exit 1
  fi

  echo "Resolving DM channel for user $userId..."
  local channelId
  channelId=$(resolve_dm_channel "$userId")
  require_channel_id "$channelId"
  echo "DM channel ID: $channelId"

  # Check if already registered
  local existing_port
  existing_port=$(get_port "$channelId")
  if [ -n "$existing_port" ]; then
    echo "Channel $channelId is already registered on port $existing_port."
    exit 0
  fi

  # Allocate port and register
  local port status
  if port=$(reserve_port "$channelId"); then
    :
  else
    status=$?
    if [ "$status" -eq 2 ]; then
      echo "Channel $channelId is already registered on port $(get_port "$channelId")."
      exit 0
    fi
    exit 1
  fi
  echo "Assigned port $port"

  # Create instance directory
  mkdir -p "$INSTANCES_DIR/$channelId"

  # Build the token-free instance config from the allowlist. Fail-closed: if it
  # cannot be written, deregister and abort rather than start a box without a
  # freshly-built config.
  if ! seed_instance_config "$channelId"; then
    echo "Error: could not build config for $channelId; aborting." >&2
    free_port "$channelId"
    exit 1
  fi

  # Start container (start_container runs prepare_instance_dirs for the token-free
  # layout: writable mounts, placeholder auth, config sanitization, ownership).
  echo "Starting container agents.channel-$channelId on port $port..."
  start_container "$channelId" "$port"
  seed_workspace "$channelId" || true
  echo "Done. User $userId can now DM the bot."
}

cmd_add_channel() {
  local channelId="${1:-}"
  if [ -z "$channelId" ]; then
    echo "Usage: openclawctl add-channel <channelId>"
    exit 1
  fi
  require_channel_id "$channelId"

  local existing_port
  existing_port=$(get_port "$channelId")
  if [ -n "$existing_port" ]; then
    echo "Channel $channelId is already registered on port $existing_port."
    exit 0
  fi

  local port status
  if port=$(reserve_port "$channelId"); then
    :
  else
    status=$?
    if [ "$status" -eq 2 ]; then
      echo "Channel $channelId is already registered on port $(get_port "$channelId")."
      exit 0
    fi
    exit 1
  fi
  echo "Assigned port $port"

  mkdir -p "$INSTANCES_DIR/$channelId"

  # Build the token-free instance config from the allowlist. Fail-closed: if it
  # cannot be written, deregister and abort rather than start a box without a
  # freshly-built config.
  if ! seed_instance_config "$channelId"; then
    echo "Error: could not build config for $channelId; aborting." >&2
    free_port "$channelId"
    exit 1
  fi

  # Start container (start_container runs prepare_instance_dirs for the token-free
  # layout: writable mounts, placeholder auth, config sanitization, ownership).
  echo "Starting container agents.channel-$channelId on port $port..."
  start_container "$channelId" "$port"
  seed_workspace "$channelId" || true
  echo "Done. Channel $channelId is now registered."
}

cmd_remove() {
  local channelId="${1:-}"
  if [ -z "$channelId" ]; then
    echo "Usage: openclawctl remove <channelId>"
    exit 1
  fi
  require_channel_id "$channelId"

  # Hold the same lock reserve_port uses across the whole stop+free sequence,
  # so a concurrent `add-*` for this channel cannot slip a freshly-assigned
  # .port in between our stop and free_port (which would delete the new port
  # and leave the new container running but undiscoverable).
  (
    flock 9

    echo "Stopping container for channel $channelId..."
    stop_container "$channelId"

    echo "Freeing port..."
    free_port "$channelId"
  ) 9>"$PORT_LOCK_FILE"

  echo "Done. Instance data preserved at $INSTANCES_DIR/$channelId/"
  echo "To delete data: rm -rf $INSTANCES_DIR/$channelId"
}

cmd_restart() {
  local channelId="${1:-}"
  if [ -z "$channelId" ]; then
    echo "Usage: openclawctl restart <channelId>"
    exit 1
  fi
  require_channel_id "$channelId"

  local port
  port=$(get_port "$channelId")
  if [ -z "$port" ]; then
    echo "Error: Channel $channelId is not registered."
    exit 1
  fi

  if ! is_prepared "$channelId"; then
    echo "Channel $channelId is on the legacy layout and is not started under the" >&2
    echo "token-free agent.yml. Re-register it to adopt the new layout (non-destructive:" >&2
    echo "remove preserves the instance data and add rebuilds the config fresh):" >&2
    echo "  openclawctl remove $channelId && openclawctl add-channel $channelId" >&2
    # Nonzero so callers can distinguish a refusal from a completed restart,
    # consistent with the other restart error paths.
    exit 1
  fi

  echo "Restarting container for channel $channelId on port $port..."
  stop_container "$channelId"
  start_container "$channelId" "$port"
  echo "Done."
}

# Re-assert a registered instance's proxy URLs (model proxy + container proxy) and
# /workspace path from the current agent-bridge env, WITHOUT recreating the
# container. boot.sh calls this before starting each box so a deploy that changed
# the bridge gateway IP (e.g. a host-networking -> bridge migration) reaches the
# existing instance configs; otherwise a box keeps a stale baseUrl (e.g. an old
# 127.0.0.1 that is now its own loopback) and the model path silently breaks.
cmd_reconcile() {
  local channelId="${1:-}"
  if [ -z "$channelId" ]; then
    echo "Usage: openclawctl reconcile <channelId>" >&2
    exit 1
  fi
  require_channel_id "$channelId"

  if [ -z "$(get_port "$channelId")" ]; then
    echo "Error: Channel $channelId is not registered." >&2
    exit 1
  fi

  # Only touch token-free instances. A legacy instance keeps a different config
  # shape; rewriting its workspace/proxy fields (force_box_config sets
  # workspace=/workspace) without the matching mount layout would misconfigure it.
  if ! is_prepared "$channelId"; then
    echo "Channel $channelId is on the legacy layout; refusing to rewrite its config." >&2
    echo "Re-register it to adopt the token-free layout (non-destructive; keeps the" >&2
    echo "instance data): openclawctl remove $channelId && openclawctl add-channel $channelId" >&2
    exit 1
  fi

  # Propagate failure (force_box_config returns nonzero on a missing/unwritable
  # config) so callers like boot.sh can skip starting a box with stale proxy URLs.
  force_box_config "$INSTANCES_DIR/$channelId/openclaw.json"
}

cmd_list() {
  BASE_PORT="$BASE_PORT" PORT_FILENAME="$PORT_FILENAME" python3 -c "
import os, re, subprocess
instances_dir = '$INSTANCES_DIR'
base = int(os.environ['BASE_PORT'])
port_filename = os.environ['PORT_FILENAME']

# Discover ports from each instance's dotfile.
assignments = {}
for entry in sorted(os.listdir(instances_dir)):
    if not re.match(r'^\d{17,20}\$', entry):
        continue
    pf = os.path.join(instances_dir, entry, port_filename)
    if not os.path.isfile(pf):
        print(f'  Warning: {entry} has no port assignment')
        continue
    raw = open(pf).read().strip()
    # Same strict rule as the router: all ASCII digits, value > 0.
    if re.fullmatch(r'[0-9]+', raw) and int(raw) > 0:
        assignments[entry] = int(raw)
    else:
        print(f'  Warning: {entry} has an invalid .port file')

print('Registered channels:')
print()
if not assignments:
    print('  (none)')
else:
    for cid, port in sorted(assignments.items(), key=lambda x: x[1]):
        result = subprocess.run(
            ['docker', 'inspect', '-f', '{{.State.Status}}', f'agents.channel-{cid}'],
            capture_output=True, text=True
        )
        status = result.stdout.strip() if result.returncode == 0 else 'not found'
        print(f'  {cid}  port={port}  status={status}')

# Show port summary
used = set(assignments.values())
max_port = max(used) if used else base - 1
gaps = [p for p in range(base, max_port + 1) if p not in used]
print()
print(f'Port range: {base}-{max_port} ({len(assignments)} used)')
if gaps:
    print(f'Available ports (gaps): {gaps}')
print(f'Next port: {max_port + 1 if not gaps else min(gaps)}')
"
}

# --- Main ---

case "${1:-}" in
  add-dm)      cmd_add_dm "${2:-}" ;;
  add-channel) cmd_add_channel "${2:-}" ;;
  remove)      cmd_remove "${2:-}" ;;
  restart)     cmd_restart "${2:-}" ;;
  reconcile)   cmd_reconcile "${2:-}" ;;
  list)        cmd_list ;;
  *)
    echo "openclawctl — Manage OpenClaw agent containers"
    echo ""
    echo "Commands:"
    echo "  add-dm <userId>         Register a DM channel for a Discord user"
    echo "  add-channel <channelId> Register a text channel"
    echo "  remove <channelId>      Stop and deregister a channel"
    echo "  restart <channelId>     Restart a channel's container"
    echo "  reconcile <channelId>   Re-assert proxy URLs in the instance config"
    echo "  list                    List all registered channels and ports"
    ;;
esac
