{
  // Individual per-language blocks (not a combined "[a][b]" selector): VSCode
  // treats a combined language-group selector as less specific than an
  // individual "[typescript]" selector, so a user-level per-language default
  // formatter would otherwise win and oxc would never run. One block per
  // language guarantees the workspace oxc setting overrides any user default.
  "[javascript]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[hcl]": {
    "editor.defaultFormatter": "jkillian.custom-local-formatters",
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "[terraform]": {
    "editor.defaultFormatter": "jkillian.custom-local-formatters",
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "[terraform-mock]": {
    "editor.defaultFormatter": "jkillian.custom-local-formatters",
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "[terraform-search]": {
    "editor.defaultFormatter": "jkillian.custom-local-formatters",
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "[terraform-test]": {
    "editor.defaultFormatter": "jkillian.custom-local-formatters",
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "[terraform-vars]": {
    "editor.defaultFormatter": "jkillian.custom-local-formatters",
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "biome.enabled": false,
  "customLocalFormatters.formatters": [
    {
      "command": "go -C submodules/hcl4fmt run ./src/cmd/hcl4fmt -",
      "languages": [
        "hcl",
        "terraform",
        "terraform-mock",
        "terraform-search",
        "terraform-test",
        "terraform-vars"
      ]
    }
  ],
  "cmake.sourceDirectory": "${workspaceFolder}/whisper",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "npm.exclude": ["**/.builds/**"]
}
